# Copy to .env — never commit real secrets.

# Obsidian vault root (DMIT example: /srv/obsidian/vault)
VAULT_ROOT=/path/to/obsidian/vault

# session-distill paths (Huawei example: /opt/session-distill)
INBOX_DIR=/path/to/session-distill/inbox
PROCESSED_DIR=/path/to/session-distill/processed
QUARANTINE_DIR=/path/to/session-distill/quarantine
FAILED_DIR=/path/to/session-distill/failed

# Hindsight (no real keys here)
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_MCP_URL=http://127.0.0.1:8888/mcp/wanwan/
# HINDSIGHT_API_KEY=  # set in secrets.env / systemd EnvironmentFile only

# Dashboard / API
HINDDIAN_HOST=127.0.0.1
HINDDIAN_PORT=8787
# AUTH_TOKEN=  # optional Bearer for /api/* when exposed

# Status store
STATUS_DB=./data/hinddian.db
USE_DEMO_DATA=true

# Topic vault paths (relative to VAULT_ROOT)
AGENT_TIPS_RELPATH=00-系统/agent使用技巧.md
PROJECTS_DIRNAME=项目
