# Optional environment settings. Keep real credentials outside the repository.
# Hooks and batch also read paths from ~/.config/hinddian/config.json.
# HINDDIAN_VAULT=~/Obsidian/vault
# HINDDIAN_DRAFTS_DIR=~/Obsidian/drafts
# HINDDIAN_PROCESSED_DIR=~/Obsidian/processed
# HINDDIAN_STATE_DIR=~/.local/state/hinddian
# HINDDIAN_CAPTURE_MODE=local
# HINDDIAN_SESSION_IDLE_SEC=1800

# Optional HTTP collector and dashboard. Keep the two credentials distinct.
HINDDIAN_HOST=127.0.0.1
HINDDIAN_PORT=8787
# AUTH_TOKEN=
# HINDDIAN_MCP_TOKEN=  # existing variable name for the HTTP collector credential
# HINDDIAN_MEMORY_URL=https://<collector-host>:8444/hinddian
# HINDDIAN_CA_FILE=

# Jev uses the local System One gateway, with optional TypeSafe fallback.
# JEV_BASE_URL=http://127.0.0.1:3425/v1/systemone
# JEV_API_KEY=
# JEV_MODEL=typesafe/jev-latest
# JEV_MIN_CONFIDENCE=0.65
# TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# JEV_FORCE_CLOUD=0

# OpenAI-compatible chat for batch and Jev enrichment.
# HB_GATEWAY=http://127.0.0.1:3425/v1/chat/completions
# HB_MODEL=group/auto-flash
# JEV_FALLBACK_MODEL=group/auto-flash
