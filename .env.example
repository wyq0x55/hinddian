# Copy to .env — never commit real secrets.

# Obsidian vault root (DMIT: /srv/obsidian/vault). Leave unset on Huawei for now.
# VAULT_ROOT=/srv/obsidian/vault

# session-distill paths (Huawei: /opt/session-distill)
INBOX_DIR=/opt/session-distill/inbox
PROCESSED_DIR=/opt/session-distill/processed
QUARANTINE_DIR=/opt/session-distill/quarantine
FAILED_DIR=/opt/session-distill/failed

# Hindsight (no real keys here)
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_MCP_URL=http://127.0.0.1:8888/mcp/wanwan/
# HINDSIGHT_API_KEY=  # set in secrets.env / systemd EnvironmentFile only

# Dashboard / API
HINDDIAN_HOST=127.0.0.1
HINDDIAN_PORT=8787
# AUTH_TOKEN=  # leave empty when Caddy mTLS is the gate

# Status store
STATUS_DB=./data/hinddian.db
# Production: false. Demo only when inbox paths missing AND this is true.
USE_DEMO_DATA=false

# Topic vault paths (relative to VAULT_ROOT)
AGENT_TIPS_RELPATH=00-系统/agent使用技巧.md
PROJECTS_DIRNAME=项目

# DMIT classify stage (pi) — reached via root SSH alias (same as session-distill)
CLASSIFY_SSH_HOST=dmit-vps

# hinddian-memory MCP Bearer (defaults to HINDSIGHT_API_KEY if unset)
# HINDDIAN_MCP_TOKEN=

# Public base URL for host hooks / clients (Caddy :80 /hinddian/* → :8787).
# Must include the /hinddian prefix; hooks call {HINDDIAN_MEMORY_URL}/api/memory/...
# Example (Huawei public):
HINDDIAN_MEMORY_URL=http://124.70.90.224/hinddian
# Local-only smoke:
# HINDDIAN_MEMORY_URL=http://127.0.0.1:8787

# Agent corrections queue (DMIT SoT path; Huawei reaches via SSH CLI)
# HB_CORRECTIONS=/var/lib/hinddian/agent_corrections
# HB_DRAFTS=/var/lib/hinddian/drafts
# HINDDIAN_ROUTING=/var/lib/hinddian/routing

# Session bucket idle before finalize (seconds; default 1800 = 30 min)
# HINDDIAN_SESSION_IDLE_SEC=1800

# --- Jev (System One) — local OpenAI-compatible gateway preferred ---
# Any host exposing /v1/systemone works. Default:
#   POST http://127.0.0.1:3425/v1/systemone
# Write path: local → optional cloud → else source=none (do NOT auto-keep via loose LLM).
# JEV_BASE_URL=http://127.0.0.1:3425/v1/systemone
# JEV_API_KEY=          # bearer for local gateway; defaults to "magpie" only as legacy token string
# JEV_MODEL=typesafe/jev-latest
# JEV_GATEWAY=          # optional base scheme://host:port (else derived from HB_GATEWAY)
# HB_GATEWAY=http://127.0.0.1:3425/v1/chat/completions   # recall/UX soft fallback chat
# JEV_MIN_CONFIDENCE=0.65
# JEV_FALLBACK_MODEL=group/auto-flash   # recall/UX soft fallback only — not write keep
# Deprecated aliases (still read): MAGPIE_JEV_URL, MAGPIE_GATEWAY_KEY, MAGPIE_GATEWAY
# Optional cloud fallback only (put real key only in /opt/hinddian/.env — never git):
# TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# JEV_FORCE_CLOUD=0
