# Copy to .env — never commit real secrets.

# Obsidian vault root (DMIT: /srv/obsidian/vault). Leave unset on Huawei for now.
# VAULT_ROOT=/srv/obsidian/vault

# session-distill paths (Huawei: /opt/session-distill)
INBOX_DIR=/opt/session-distill/inbox
PROCESSED_DIR=/opt/session-distill/processed
QUARANTINE_DIR=/opt/session-distill/quarantine
FAILED_DIR=/opt/session-distill/failed

# Hindsight (no real keys here)
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_MCP_URL=http://127.0.0.1:8888/mcp/wanwan/
# HINDSIGHT_API_KEY=  # set in secrets.env / systemd EnvironmentFile only

# Dashboard / API
HINDDIAN_HOST=127.0.0.1
HINDDIAN_PORT=8787
# AUTH_TOKEN=  # leave empty when Caddy mTLS is the gate

# Status store
STATUS_DB=./data/hinddian.db
# Production: false. Demo only when inbox paths missing AND this is true.
USE_DEMO_DATA=false

# Topic vault paths (relative to VAULT_ROOT)
AGENT_TIPS_RELPATH=00-系统/agent使用技巧.md
PROJECTS_DIRNAME=项目

# DMIT classify stage (pi) — reached via root SSH alias (same as session-distill)
CLASSIFY_SSH_HOST=dmit-vps

# hinddian-memory MCP (Bearer; defaults to HINDSIGHT_API_KEY if unset)
# HINDDIAN_MCP_TOKEN=

# Public path prefix used by Magpie hooks (Caddy :80 /hinddian/* → :8787)
# HINDDIAN_MEMORY_URL=http://124.70.90.224/hinddian

# TypeSafe Jev (System One). Put the real key only in /opt/hinddian/.env or /etc/hinddian-memory.env — never in git.
# TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# JEV_MIN_CONFIDENCE=0.65
# JEV_FALLBACK_MODEL=group/auto-flash
