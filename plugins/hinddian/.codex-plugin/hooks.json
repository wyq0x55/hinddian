{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start_entry.py\"",
            "statusMessage": "hinddian: check local configuration"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/turn_end_entry.py\"",
            "statusMessage": "hinddian: capture final reply"
          }
        ]
      }
    ]
  }
}
