[Unit]
Description=hinddian dashboard and explicit draft submissions
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hinddian
EnvironmentFile=-%h/.config/hinddian/api.env
Environment=HINDDIAN_HOST=127.0.0.1
Environment=HINDDIAN_PORT=8787
ExecStart=/opt/hinddian/.venv/bin/uvicorn hinddian.api:app --app-dir /opt/hinddian/src --host ${HINDDIAN_HOST} --port ${HINDDIAN_PORT}
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
