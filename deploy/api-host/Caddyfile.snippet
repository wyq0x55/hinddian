# Optional HTTPS dashboard. Run the API with the same vault and draft paths as batch.
# Dashboard channel: mTLS. After the client cert verifies, Caddy presents the dashboard
# credential itself — the browser never holds AUTH_TOKEN.
# caddy.service needs HINDDIAN_DASHBOARD_TOKEN (= hinddian's AUTH_TOKEN) in its environment,
# e.g. EnvironmentFile=/etc/caddy/hinddian.env (mode 600).
#
# Global options (once, at top of Caddyfile) — same as vault host Magpie:
# {
# 	auto_https off
# 	admin off
# 	# IP-only TLS + client_auth: browsers omit SNI for raw IPs (RFC 6066).
# 	servers {
# 		strict_sni_host insecure_off
# 	}
# }

{$HINDDIAN_DASHBOARD_ADDRESS} {
	tls {$HINDDIAN_DASHBOARD_CERT} {$HINDDIAN_DASHBOARD_KEY} {
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file {$HINDDIAN_DASHBOARD_CA}
		}
	}
	encode gzip
	reverse_proxy 127.0.0.1:8787 {
		header_up -Authorization
		header_up X-Hinddian-Dashboard {$HINDDIAN_DASHBOARD_TOKEN}
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Proto
		header_up -X-Forwarded-Host
		header_up -X-Real-Ip
		header_up -Forwarded
	}
}
