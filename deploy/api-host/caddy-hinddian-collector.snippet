# Optional HTTPS collector. Set HINDDIAN_MEMORY_URL to the address below plus /hinddian.
# The upstream checks the collector's bearer credential.
{$HINDDIAN_COLLECTOR_ADDRESS} {
	tls {$HINDDIAN_COLLECTOR_CERT} {$HINDDIAN_COLLECTOR_KEY}
	encode gzip
	@capture path /hinddian/api/health /hinddian/api/memory/finalize /hinddian/api/memory/push_draft /hinddian/api/memory/gates/backend /hinddian/api/memory/jev-backend /hinddian/api/memory/gates/report
	handle @capture {
		uri strip_prefix /hinddian
		reverse_proxy 127.0.0.1:8787 {
			header_up -X-Hinddian-Dashboard
		}
	}
	respond 404
}
