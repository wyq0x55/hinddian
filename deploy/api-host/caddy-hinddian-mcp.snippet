# Agent channel over TLS: hinddian-memory MCP + hook REST only. Hooks/agents use
#   HINDDIAN_MEMORY_URL=https://<api-host>:8444/hinddian   (MCP: …/hinddian/mcp)
# with Bearer HINDDIAN_MCP_TOKEN (checked by hinddian, not by Caddy).
#
# Uses the same cert as the :8443 dashboard listener. If that cert is self-signed / private CA,
# clients must trust it (SSL_CERT_FILE for python hooks, NODE_EXTRA_CA_CERTS for node hosts).
# Dashboard routes and approvals are NOT exposed here — they live on :8443 behind mTLS.

:8444 {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	encode gzip

	# Agent-only paths (hooks + MCP). Trailing-slash / health* variants included so
	# clients that normalize URLs differently still match (unmatched → 404, never 410).
	@agent path /hinddian/mcp /hinddian/mcp/* /hinddian/api/health /hinddian/api/health/* /hinddian/api/memory /hinddian/api/memory/* /hinddian/oauth/* /hinddian/.well-known/*
	handle @agent {
		uri strip_prefix /hinddian
		reverse_proxy 127.0.0.1:8787 {
			# never let an agent-side request carry the dashboard credential
			header_up -X-Hinddian-Dashboard
		}
	}
	# MCP OAuth discovery (RFC 8414 / RFC 9728 put .well-known at the origin root,
	# with the issuer/resource path appended, e.g. /.well-known/oauth-authorization-server/hinddian).
	@wellknown path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource* /.well-known/openid-configuration*
	handle @wellknown {
		reverse_proxy 127.0.0.1:8787 {
			header_up -X-Hinddian-Dashboard
		}
	}
	respond 404
}

# Inside the existing :80 { ... } block: the old plain-http path is closed — session text and
# Bearer tokens must not cross the internet unencrypted.
#
#	handle_path /hinddian/* {
#		respond "dashboard https://<api-host>:8443/ (mTLS); agent https://<api-host>:8444/hinddian" 410
#	}
