#!/usr/bin/env python3
"""DMIT CLI for hinddian-memory vault ops (called via SSH from Huawei MCP)."""
from __future__ import annotations
import argparse, json, os, sys
from pathlib import Path

# Prefer installed package copies
for p in ("/opt/hinddian/src", "/opt/hinddian-classify/src", str(Path(__file__).resolve().parents[2] / "src")):
    if p not in sys.path and Path(p).is_dir():
        sys.path.insert(0, p)

os.environ.setdefault("VAULT_ROOT", "/srv/obsidian/vault")
os.environ.setdefault("HC_VAULT", "/srv/obsidian/vault")
os.environ.setdefault("HB_DRAFTS", "/var/lib/hinddian/drafts")

from hinddian import notes  # noqa: E402

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=[
        "routing_global", "routing_project", "get_note", "list_notes",
        "upsert_note", "push_draft", "export_routing",
    ])
    ap.add_argument("--project")
    ap.add_argument("--id")
    ap.add_argument("--type")
    ap.add_argument("--status", default="active")
    ap.add_argument("--limit", type=int, default=50)
    ap.add_argument("--json", dest="payload", help="JSON payload for upsert/push")
    a = ap.parse_args()
    if a.cmd == "routing_global":
        out = notes.routing_global()
    elif a.cmd == "routing_project":
        out = notes.routing_project(a.project or "")
    elif a.cmd == "get_note":
        out = notes.get_note(a.id or "")
    elif a.cmd == "list_notes":
        out = notes.list_notes(project=a.project, type_=a.type, status=a.status, limit=a.limit)
    elif a.cmd == "upsert_note":
        out = notes.upsert_note(json.loads(a.payload or "{}"))
    elif a.cmd == "push_draft":
        out = notes.push_draft(**json.loads(a.payload or "{}"))
    else:
        out = notes.export_routing()
    print(json.dumps(out, ensure_ascii=False))

if __name__ == "__main__":
    main()
