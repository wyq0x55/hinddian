#!/usr/bin/env python3
"""DMIT CLI for hinddian-memory vault ops (called via SSH from the Huawei API).

upsert_note here is the *agent* path (gated). decide_correction is only invoked by the
dashboard endpoints on the Huawei side and is the one trusted write.
"""
from __future__ import annotations
import argparse, json, os, sys
from pathlib import Path

# Prefer /opt/hinddian/src over classify copy
_paths = ["/opt/hinddian/src", str(Path(__file__).resolve().parents[2] / "src"), "/opt/hinddian-classify/src"]
for _p in _paths:
    if _p not in sys.path and Path(_p).is_dir():
        sys.path.insert(0, _p)

os.environ.setdefault("VAULT_ROOT", "/srv/obsidian/vault")
os.environ.setdefault("HC_VAULT", "/srv/obsidian/vault")
os.environ.setdefault("HB_DRAFTS", "/var/lib/hinddian/drafts")

from hinddian import notes  # noqa: E402

def _payload(arg: str | None) -> dict:
    if arg:
        return json.loads(arg)
    if not sys.stdin.isatty():
        raw = sys.stdin.read()
        if raw.strip():
            return json.loads(raw)
    return {}

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=[
        "routing_global", "routing_project", "get_note", "list_notes", "search_notes",
        "upsert_note", "push_draft", "export_routing",
        "suggest_correction", "list_corrections", "decide_correction",
    ])
    ap.add_argument("--project")
    ap.add_argument("--id")
    ap.add_argument("--type")
    ap.add_argument("--status", default="active")
    ap.add_argument("--limit", type=int, default=50)
    ap.add_argument("--json", dest="payload", default=None, help="JSON payload (or pass via stdin)")
    ap.add_argument("--approve", action="store_true")
    ap.add_argument("--reject", action="store_true")
    ap.add_argument("--reason", default="")
    ap.add_argument("--query", default="")
    a = ap.parse_args()
    if a.cmd == "routing_global":
        out = notes.routing_global()
    elif a.cmd == "routing_project":
        out = notes.routing_project(a.project or "")
    elif a.cmd == "get_note":
        out = notes.get_note(a.id or "")
    elif a.cmd == "list_notes":
        out = notes.list_notes(project=a.project, type_=a.type, status=a.status, limit=a.limit)
    elif a.cmd == "search_notes":
        out = notes.search_notes(a.query, project=a.project, type_=a.type, limit=a.limit)
    elif a.cmd == "upsert_note":
        out = notes.upsert_note(_payload(a.payload))
    elif a.cmd == "suggest_correction":
        pl = _payload(a.payload)
        pl["mode"] = "suggest"
        out = notes.enqueue_correction(pl)
    elif a.cmd == "list_corrections":
        out = notes.list_corrections(status=a.status or "pending", limit=a.limit)
    elif a.cmd == "decide_correction":
        if a.approve == a.reject:
            ap.error("decide_correction needs exactly one of --approve / --reject")
        out = notes.decide_correction(a.id or "", approve=a.approve, reason=a.reason or "")
    elif a.cmd == "push_draft":
        pl = _payload(a.payload)
        meta = (
            pl.get("meta") if isinstance(pl.get("meta"), dict)
            else {k: pl[k] for k in (
                "type", "confidence", "origin", "session_id", "jev_source",
                "turn_count", "finalize_reason",
            ) if k in pl}
        )
        out = notes.push_draft(
            project=pl.get("project") or "通用-未定",
            title=pl.get("title") or "session",
            body=pl.get("body") or "",
            meta=meta,
        )
    else:
        out = notes.export_routing()
    print(json.dumps(out, ensure_ascii=False))

if __name__ == "__main__":
    main()
