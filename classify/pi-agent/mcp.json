{
  "mcpServers": {
    "hinddian-memory": {
      "url": "${HINDDIAN_MCP_URL}",
      "headers": { "Authorization": "Bearer ${HINDDIAN_MCP_TOKEN}" },
      "description": "Wanwan atomic notes (Obsidian SoT). Use routing_*/recall/get_note/list_notes/upsert_note. Never raw Hindsight retain.",
      "timeout": 60,
      "exposure": "hidden",
      "toolExposure": {
        "routing_global": "direct",
        "routing_project": "direct",
        "recall": "direct",
        "get_note": "direct",
        "list_notes": "direct",
        "upsert_note": "direct",
        "push_draft": "direct"
      }
    }
  }
}
