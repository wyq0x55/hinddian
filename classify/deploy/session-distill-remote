#!/bin/bash
# Invoked from the API host worker over SSH.
# Usage:
#   session-distill-remote write <vault-relpath>   # body on stdin
#   session-distill-remote chat                     # OpenAI chat JSON body on stdin → stdout
#   session-distill-remote cat-index
set -euo pipefail
VAULT=/srv/obsidian/vault
cmd="${1:-}"
case "$cmd" in
  write)
    rel="${2:-}"
    if [[ -z "$rel" || "$rel" == /* || "$rel" == *..* ]]; then
      echo "bad path" >&2; exit 2
    fi
    # only allow under 项目/*/待入库/ or 00-系统/
    if [[ ! "$rel" =~ ^项目/[^/]+/待入库/[^/]+$ && ! "$rel" =~ ^00-系统/ ]]; then
      echo "path not allowed: $rel" >&2; exit 3
    fi
    if [[ "$rel" =~ ^项目/[^/]+/待入库/([^/]+)$ ]]; then
      # hinddian: drafts live outside the vault, grouped by inferred project
      tmp=$(mktemp); cat > "$tmp"
      proj=$(/usr/local/bin/hinddian-infer "$tmp")
      dest="/var/lib/hinddian/drafts/$proj/${BASH_REMATCH[1]}"
      mkdir -p "$(dirname "$dest")"; mv "$tmp" "$dest"; chmod 644 "$dest"
    else
      dest="$VAULT/$rel"
      mkdir -p "$(dirname "$dest")"
      cat > "$dest"
      chown obsidian:obsidian "$dest"
      chmod 664 "$dest"
    fi
    echo "wrote $dest"
    ;;
  chat)
    curl -sS --fail-with-body \
      -H "Authorization: Bearer magpie" \
      -H "Content-Type: application/json" \
      --data-binary @- \
      "http://127.0.0.1:3425/v1/chat/completions"
    ;;
  cat-index)
    cat "$VAULT/00-系统/INDEX.md"
    ;;
  *)
    echo "usage: write|chat|cat-index" >&2; exit 1
    ;;
esac
